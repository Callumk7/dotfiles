# Portable interactive shell baseline.
export EDITOR=nvim
export VISUAL=nvim

# Keep PATH entries unique.
typeset -U path
path=("$HOME/.local/bin" $path)

export PATH

# History shared between interactive shells.
HISTFILE="$HOME/.zsh_history"
HISTSIZE=10000
SAVEHIST=10000
setopt APPEND_HISTORY SHARE_HISTORY HIST_IGNORE_SPACE HIST_IGNORE_DUPS

# Standard zsh completion and a dependency-free prompt.
autoload -Uz compinit
compinit
PROMPT='%n@%m %~ %# '

alias vim='nvim'
alias cl='clear'
alias ll='ls -lh'

# Activate development tools before loading private local overrides.
if command -v mise >/dev/null 2>&1; then
  eval "$(mise activate zsh)"
fi

# Secrets and machine-specific settings stay outside the dotfiles repository.
if [[ -r "$HOME/.config/zsh/local.zsh" ]]; then
  source "$HOME/.config/zsh/local.zsh"
fi

# Simple shared Oh My Zsh fallback. A private overlay may already load its own setup.
if (( ! $+functions[omz] )) && [[ -r "${ZSH:-$HOME/.oh-my-zsh}/oh-my-zsh.sh" ]]; then
  export ZSH="${ZSH:-$HOME/.oh-my-zsh}"
  ZSH_THEME="${ZSH_THEME:-robbyrussell}"
  if (( ! ${+plugins} )); then
    # fzf-tab must precede widget wrappers; syntax highlighting loads last.
    plugins=(git zoxide fzf fzf-tab zsh-autosuggestions zsh-interactive-cd zsh-syntax-highlighting)
  fi
  # Keep the bootstrapped version stable; updates are deliberate.
  zstyle ':omz:update' mode disabled
  source "$ZSH/oh-my-zsh.sh"
fi
